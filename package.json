{
  "name": "casey-game-portfolio",
  "version": "1.0.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx scripts/validate-games.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node --import tsx scripts/check-links.ts",
    "render:covers": "node scripts/render-covers.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test --project=checks",
    "screenshots": "playwright test --project=screenshots",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "framer-motion": "^14.11.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "overrides": {
    "basic-ftp": "^6.2.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  }
}
